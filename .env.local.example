
# .env.local nunca debe subirse al repositorio

# --- Supabase ---
# URL y anon key del proyecto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key: acceso administrativo total a la base de datos.

SUPABASE_SERVICE_ROLE_KEY=

# --- IA: OpenRouter ---
# La generación de itinerarios usa OpenRouter (API compatible con OpenAI).
# Uso exclusivo en servidor (services/gemini).
# Clave de https://openrouter.ai/keys (obligatoria).
OPENROUTER_API_KEY=
# Modelo a usar (opcional). Por defecto: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
# Base URL (opcional). Por defecto: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- Unsplash ---

UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=
